# Lovable / Supabase frontend env template.
# Real values live in .env (gitignored). Anon key is safe to share, but keep
# this file as placeholders so contributors don't accidentally commit secrets.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"